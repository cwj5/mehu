{
  "name": "overview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "validate:parity-matrix": "node scripts/validate-parity-matrix.mjs",
    "test:parity-backend": "cargo test --manifest-path src-tauri/Cargo.toml --lib backend_parity_fixtures_match_expected_outputs",
    "test:parity-cross-path": "vitest run src/App.integration.test.tsx",
    "test:parity": "npm run validate:parity-matrix && npm run test:parity-backend && npm run test:parity-cross-path",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/three": "^0.182.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^29.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.0.0"
  }
}
